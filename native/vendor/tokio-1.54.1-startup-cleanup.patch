     pub(crate) fn launch(mut self) {
+        // Retain all cores until startup completes so a failed spawn can be
+        // unwound without leaving workers running or unstarted cores behind.
+        for worker in self.0.iter().cloned() {
+            runtime::spawn_blocking(move || run(worker));
+        }
+        self.0.clear();
+    }
+}
